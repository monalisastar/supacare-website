// ============================================================
// SUPACARE SUSTAINABILITY OPERATING SYSTEM (SOS)
// Unified Prisma Schema for Auth, Consultancy, Carbon,
// Waste/Compost, Billing, Messaging, Alerts, Analytics & CMS
// Database: MongoDB
// ============================================================

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// ============================================================
/// ENUMS
/// ============================================================

enum UserRole {
  ADMIN
  CONSULTANT
  CLIENT
  PARTNER
  CUSTOMER
}

enum ProjectStatus {
  NEW
  ACTIVE
  COMPLETED
}

enum ConsultancyCategory {
  ENVIRONMENTAL
  CARBON
}

enum ConsultancyStatus {
  PENDING
  QUOTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  APPROVED
}

enum CarbonStage {
  CONCEPT
  VALIDATION
  VERIFICATION
  ISSUANCE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentEntityType {
  CONSULTANCY
  CARBON
  WASTE
  MACHINE
  COMPOST_SALE
  SMART_AUDIT
  SUBSCRIPTION
}

enum PaymentMethod {
  MPESA
  CARD
  CRYPTO
}

enum MachineStatus {
  RUNNING
  MAINTENANCE
  OFFLINE
}

enum BinStatus {
  EMPTY
  PARTIAL
  FULL
  DAMAGED
}

enum AuditStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ChatMessageType {
  TEXT
  FILE
  IMAGE
}

enum MessageRole {
  USER
  AI
  SYSTEM
}

enum NotificationType {
  BIN_FULL
  MACHINE_OFFLINE
  PAYMENT_RECEIVED
  PROJECT_UPDATE
}

enum ContentType {
  TEXT
  RICH_TEXT
  IMAGE
  VIDEO
  PDF
  GALLERY
  COMPONENT
}

/// ============================================================
/// 1️⃣ USER & AUTHENTICATION
/// ============================================================

model User {
  id                    String                 @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  email                 String                 @unique
  passwordHash          String?
  googleId              String?
  role                  UserRole               @default(CLIENT)
  organization          String?
  avatarUrl             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?

  // NextAuth
  accounts              Account[]
  sessions              Session[]

  // Projects
  consultancyProjects   ConsultancyProject[]   @relation("ClientConsultancy")
  consultingAssigned    ConsultancyProject[]   @relation("ConsultantConsultancy")
  carbonProjects        CarbonProject[]        @relation("ClientCarbonProjects")
  carbonAssigned        CarbonProject[]        @relation("ConsultantCarbonProjects")

  // Ops & Commerce
  wasteMachines         CompostMachine[]
  payments              Payment[]
  compostSales          CompostSale[]
  wastePickups          WastePickup[]

  // Messaging
  sentMessages          Message[]              @relation("MessagesBySender")
  clientThreads         MessageThread[]        @relation("ClientThreads")
  consultantThreads     MessageThread[]        @relation("ConsultantThreads")

  // Misc
  smartAudits           SmartAuditRequest[]
  activityLogs          ActivityLog[]
  sustainabilityMetrics SustainabilityMetric[]
  blogPosts             BlogPost[]
  carbonReports         CarbonReport[]
  resetTokens           PasswordResetToken[]
}

model Account {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  email     String
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  String?
  action    String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// ============================================================
/// 2️⃣ ENVIRONMENTAL & CARBON CONSULTANCY
/// ============================================================

model ConsultancyProject {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  referenceCode   String               @unique
  title           String
  description     String?
  category        ConsultancyCategory  @default(ENVIRONMENTAL)
  status          ConsultancyStatus    @default(PENDING)
  budgetEstimate  Float?
  totalCost       Float?
  clientId        String               @db.ObjectId
  consultantId    String?              @db.ObjectId
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  // Relations
  client          User                 @relation("ClientConsultancy", fields: [clientId], references: [id])
  consultant      User?                @relation("ConsultantConsultancy", fields: [consultantId], references: [id])
  milestones      ConsultancyMilestone[]
  reports         ConsultancyReport[]
  threads         MessageThread[]      @relation("ProjectThreads")

  @@index([clientId])
  @@index([consultantId])
}

model ConsultancyMilestone {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  status      MilestoneStatus @default(PENDING)
  amount      Float
  dueDate     DateTime?
  projectId   String          @db.ObjectId
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project     ConsultancyProject @relation(fields: [projectId], references: [id])
  payments    Payment[]

  @@index([projectId])
}

model ConsultancyReport {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  fileUrl     String?
  projectId   String             @db.ObjectId
  uploadedAt  DateTime           @default(now())

  project ConsultancyProject @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

/// ============================================================
/// 3️⃣ CARBON PROJECT DEVELOPMENT
/// ============================================================

model CarbonProject {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  methodology  String
  annualTarget Float?
  stage        CarbonStage   @default(CONCEPT)
  clientId     String        @db.ObjectId
  consultantId String?       @db.ObjectId
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  client     User     @relation("ClientCarbonProjects", fields: [clientId], references: [id])
  consultant User?    @relation("ConsultantCarbonProjects", fields: [consultantId], references: [id])
  uploads    MRVUpload[]
  ledger     CarbonCreditLedger[]
  reports    CarbonReport[]

  @@index([clientId])
  @@index([consultantId])
}

model MRVUpload {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String        @db.ObjectId
  fileUrl     String
  description String?
  uploadedAt  DateTime      @default(now())

  project CarbonProject @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model CarbonCreditLedger {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String        @db.ObjectId
  credits     Float
  tokenized   Boolean       @default(false)
  transaction String?
  createdAt   DateTime      @default(now())

  project CarbonProject @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model CarbonReport {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  reportUrl String?
  projectId String   @db.ObjectId
  authorId  String?  @db.ObjectId
  createdAt DateTime @default(now())

  project CarbonProject @relation(fields: [projectId], references: [id])
  author  User?        @relation(fields: [authorId], references: [id])

  @@index([projectId])
  @@index([authorId])
}

/// ============================================================
/// 4️⃣ WASTE MANAGEMENT & COMPOSTING
/// ============================================================

model CompostMachine {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  location  String
  status    MachineStatus @default(RUNNING)
  clientId  String        @db.ObjectId
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  client      User                @relation(fields: [clientId], references: [id])
  logs        CompostLog[]
  maintenance CompostMaintenance[]
  sales       CompostSale[]
  alerts      Alert[]

  @@index([clientId])
}

model CompostLog {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  machineId  String         @db.ObjectId
  date       DateTime       @default(now())
  inputKg    Float
  outputKg   Float
  efficiency Float?

  machine CompostMachine @relation(fields: [machineId], references: [id])

  @@index([machineId])
}

model CompostMaintenance {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  machineId String         @db.ObjectId
  note      String
  date      DateTime       @default(now())
  type      String?
  resolved  Boolean        @default(false)

  machine CompostMachine @relation(fields: [machineId], references: [id])

  @@index([machineId])
}

model CompostSale {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  buyerName String
  volumeKg  Float
  price     Float
  date      DateTime        @default(now())
  clientId  String?         @db.ObjectId
  machineId String?         @db.ObjectId

  client  User?           @relation(fields: [clientId], references: [id])
  machine CompostMachine? @relation(fields: [machineId], references: [id])

  @@index([clientId])
  @@index([machineId])
}

model WasteRoute {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  area      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickups WastePickup[]
}

model WastePickup {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  routeId   String   @db.ObjectId
  date      DateTime @default(now())
  wasteType String
  weightKg  Float
  clientId  String?  @db.ObjectId

  route  WasteRoute @relation(fields: [routeId], references: [id])
  client User?      @relation(fields: [clientId], references: [id])

  @@index([routeId])
  @@index([clientId])
}

/// ============================================================
/// 5️⃣ PAYMENTS & BILLING
/// ============================================================

model Payment {
  id            String                @id @default(auto()) @map("_id") @db.ObjectId
  userId        String                @db.ObjectId
  entityType    PaymentEntityType
  entityId      String?               @db.ObjectId
  milestoneId   String?               @db.ObjectId
  amount        Float
  currency      String                @default("KES")
  method        PaymentMethod         @default(MPESA)
  status        PaymentStatus         @default(PENDING)
  transactionId String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user       User                  @relation(fields: [userId], references: [id])
  milestone  ConsultancyMilestone? @relation(fields: [milestoneId], references: [id])

  @@index([userId])
  @@index([entityId])
  @@index([milestoneId])
}

/// ============================================================
/// 6️⃣ MESSAGING (Threads & Messages)
/// ============================================================

model MessageThread {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  consultantId   String?             @db.ObjectId
  clientId       String?             @db.ObjectId
  projectId      String?             @db.ObjectId
  isQuoteRequest Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  client         User?               @relation("ClientThreads", fields: [clientId], references: [id])
  consultant     User?               @relation("ConsultantThreads", fields: [consultantId], references: [id])
  project        ConsultancyProject? @relation("ProjectThreads", fields: [projectId], references: [id])
  messages       Message[]

  @@index([clientId])
  @@index([consultantId])
  @@index([projectId])
}

model Message {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  threadId  String           @db.ObjectId
  senderId  String           @db.ObjectId
  type      ChatMessageType  @default(TEXT)
  role      MessageRole      @default(USER)
  content   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id])
  sender User          @relation("MessagesBySender", fields: [senderId], references: [id])

  @@index([threadId])
  @@index([senderId])
}

/// ============================================================
/// 7️⃣ ALERTS, SMART AUDITS, ANALYTICS
/// ============================================================

model SmartAuditRequest {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  clientId    String      @db.ObjectId
  status      AuditStatus @default(PENDING)
  requestedAt DateTime    @default(now())

  client User @relation(fields: [clientId], references: [id])

  @@index([clientId])
}

model Alert {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  type      NotificationType
  message   String
  createdAt DateTime         @default(now())
  machineId String?          @db.ObjectId

  machine CompostMachine? @relation(fields: [machineId], references: [id])

  @@index([machineId])
}

model SustainabilityMetric {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId        String   @db.ObjectId
  co2Reduced      Float?   @default(0)
  wasteDiverted   Float?   @default(0)
  compostProduced Float?   @default(0)
  treesPlanted    Int?     @default(0)
  createdAt       DateTime @default(now())

  client User @relation(fields: [clientId], references: [id])

  @@index([clientId])
}

/// ============================================================
/// 8️⃣ BLOG & CMS
/// ============================================================

model BlogPost {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  authorId    String    @db.ObjectId
  content     Json
  excerpt     String?
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model PageContent {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  page      String
  section   String
  type      ContentType
  content   Json
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Float
  image       String?
  category    String?
  stock       Int       @default(0)
  externalUrl String?
  specs       Json?     // 🆕 store feature key/value pairs
  createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
}

