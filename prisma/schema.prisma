datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// ==========================
/// Enums
/// ==========================
enum UserRole {
  ADMIN
  CONSULTANT
  CLIENT
}

enum ProjectStatus {
  NEW
  ACTIVE
  COMPLETED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentEntityType {
  PROJECT
  MILESTONE
  COMPOST_SALE
  SMART_AUDIT
}

enum MachineStatus {
  RUNNING
  MAINTENANCE
  OFFLINE
}

enum BinStatus {
  EMPTY
  PARTIAL
  FULL
  DAMAGED
}

enum AuditStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ChatMessageType {
  TEXT
  FILE
  IMAGE
}

enum NotificationType {
  BIN_FULL
  MACHINE_OFFLINE
  PAYMENT_RECEIVED
  PROJECT_UPDATE
}

/// ==========================
/// Core Models
/// ==========================
model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  email          String   @unique
  passwordHash   String?
  googleId       String?  @unique
  role           UserRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  // Relations
  accounts           Account[]
  sessions           Session[]
  projects           Project[]     @relation("ClientProjects")
  consulting         Project[]     @relation("ConsultantProjects")
  messages           ChatMessage[]
  payments           Payment[]
  compostingMachines CompostingMachine[]
  smartAuditRequests SmartAuditRequest[]
  threadParticipants ThreadParticipant[]
  passwordResetTokens PasswordResetToken[]
  activityLogs       ActivityLog[]
  compostSales       CompostSale[]
  trainingSessions   TrainingSession[]
  farmSupplies       FarmSupply[]
  insightReports     InsightReport[]
}

model Account {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  String?
  action    String
  createdAt DateTime @default(now())
}

/// ==========================
/// Communication
/// ==========================
model ChatThread {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  serviceType String
  entityId    String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants ThreadParticipant[]
  messages     ChatMessage[]
}

model ThreadParticipant {
  id       String     @id @default(auto()) @map("_id") @db.ObjectId
  userId   String     @db.ObjectId
  threadId String     @db.ObjectId

  user     User       @relation(fields: [userId], references: [id])
  thread   ChatThread @relation(fields: [threadId], references: [id])
}

model ChatMessage {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  type      ChatMessageType @default(TEXT)
  content   String
  senderId  String          @db.ObjectId
  threadId  String          @db.ObjectId
  sender    User            @relation(fields: [senderId], references: [id])
  thread    ChatThread      @relation(fields: [threadId], references: [id])
  createdAt DateTime        @default(now())
}

/// ==========================
/// Payments
/// ==========================
model Payment {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  userId        String             @db.ObjectId
  user          User               @relation(fields: [userId], references: [id])
  entityType    PaymentEntityType
  entityId      String?            @db.ObjectId
  milestone     Milestone?         @relation(fields: [entityId], references: [id])
  amount        Float
  currency      String
  status        PaymentStatus
  transactionId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([entityId])
}

/// ==========================
/// Consultancy
/// ==========================
model Project {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  status       ProjectStatus @default(NEW)
  clientId     String        @db.ObjectId
  consultantId String?       @db.ObjectId
  team         String[]      @default([])  // 👈 NEW FIELD
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  client     User     @relation("ClientProjects", fields: [clientId], references: [id])
  consultant User?    @relation("ConsultantProjects", fields: [consultantId], references: [id])
  milestones Milestone[]
  insightReports InsightReport[]
}

model Milestone {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  status      MilestoneStatus @default(PENDING)
  amount      Float
  dueDate     DateTime?
  projectId   String          @db.ObjectId
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  payments Payment[]
}

/// ==========================
/// Composting
/// ==========================
model CompostingMachine {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  location  String
  status    MachineStatus @default(RUNNING)
  clientId  String        @db.ObjectId
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  client    User               @relation(fields: [clientId], references: [id])
  processes CompostingProcess[]
  sales     CompostSale[]
  trainings TrainingSession[]
  alerts    Alert[]
}

model CompostSale {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  buyerName String
  volumeKg  Float
  price     Float
  date      DateTime           @default(now())
  clientId  String?            @db.ObjectId
  machineId String?            @db.ObjectId

  client  User?              @relation(fields: [clientId], references: [id])
  machine CompostingMachine? @relation(fields: [machineId], references: [id])
}

model TrainingSession {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  topic     String
  trainer   String
  date      DateTime
  completed Boolean            @default(false)
  clientId  String?            @db.ObjectId
  machineId String?            @db.ObjectId

  client  User?              @relation(fields: [clientId], references: [id])
  machine CompostingMachine? @relation(fields: [machineId], references: [id])
}

model CompostingProcess {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  stage      String
  inputKg    Float
  outputKg   Float
  efficiency Float
  machineId  String            @db.ObjectId
  date       DateTime          @default(now())

  machine CompostingMachine @relation(fields: [machineId], references: [id])
}

model FarmSupply {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  farmName     String
  volumeKg     Float
  deliveryDate DateTime
  clientId     String?  @db.ObjectId

  client User? @relation(fields: [clientId], references: [id])
}

/// ==========================
/// Waste Collection
/// ==========================
model Route {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  area      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  bins      Bin[]
  schedules Schedule[]
}

model Bin {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  location   String
  status     BinStatus    @default(EMPTY)
  routeId    String       @db.ObjectId
  deletedAt  DateTime?

  route      Route        @relation(fields: [routeId], references: [id])
  readings   BinReading[]
  alerts     Alert[]
}

model BinReading {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  binId     String   @db.ObjectId
  level     Float
  recordedAt DateTime @default(now())

  bin Bin @relation(fields: [binId], references: [id])
}

model Schedule {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  date    DateTime
  notes   String?
  routeId String   @db.ObjectId

  route Route @relation(fields: [routeId], references: [id])
}

/// ==========================
/// Smart Waste
/// ==========================
model SmartAuditRequest {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  clientId    String      @db.ObjectId
  status      AuditStatus @default(PENDING)
  requestedAt DateTime    @default(now())

  client User @relation(fields: [clientId], references: [id])
}

model Alert {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  type      NotificationType
  message   String
  createdAt DateTime           @default(now())
  binId     String?            @db.ObjectId
  machineId String?            @db.ObjectId

  bin     Bin?              @relation(fields: [binId], references: [id])
  machine CompostingMachine? @relation(fields: [machineId], references: [id])
}

model InsightReport {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String
  createdAt DateTime @default(now())
  clientId  String?  @db.ObjectId
  projectId String?  @db.ObjectId

  client  User?    @relation(fields: [clientId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
}
